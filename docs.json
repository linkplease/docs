{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "MetaSmart API",
  "colors": {
    "primary": "#4F46E5",
    "light": "#6366F1",
    "dark": "#4338CA"
  },
  "favicon": "https://app.metasmart.io/metasmart-favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["index", "quickstart", "authentication", "errors"]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "openapi.yaml"
      }
    ]
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "javascript", "python"],
      "defaults": "required"
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Open MetaSmart",
      "href": "https://app.metasmart.io"
    }
  },
  "footer": {
    "socials": {
      "website": "https://app.metasmart.io"
    }
  }
}
